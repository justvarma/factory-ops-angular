{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ng": "ng build --watch",
    "dev:server": "tsx watch server.ts",
    "dev": "concurrently \"npm run dev:ng\" \"npm run dev:server\" \"next dev -p 3001\"",
    "build:ng": "ng build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:next --external:prisma --external:@prisma/client --external:express --external:path --external:url",
    "build": "npm run build:ng && next build && npm run build:server",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "clean": "next clean && rm -rf dist"
  },
  "dependencies": {
    "@angular/animations": "19.2.21",
    "@angular/common": "19.2.21",
    "@angular/compiler": "19.2.21",
    "@angular/core": "19.2.21",
    "@angular/forms": "19.2.21",
    "@angular/platform-browser": "19.2.21",
    "@angular/platform-browser-dynamic": "19.2.21",
    "@angular/router": "19.2.21",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.19.3",
    "@types/express": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-angular": "^0.477.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.10",
    "prisma": "^6.19.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.72.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.19.3",
    "zod": "^4.3.6",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.21",
    "@angular/cli": "19.2.21",
    "@angular/compiler-cli": "19.2.21",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4"
  }
}
