generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Renamedbreak {
  id          Int                      @id @default(autoincrement())
  shift_id    Int?
  break_start DateTime?                @db.Time(6)
  break_end   DateTime?                @db.Time(6)
  duration    Unsupported("interval")? @default(dbgenerated("(break_end - break_start)"))
  break_type  String?                  @db.VarChar(50)
  shift       shift?                   @relation(fields: [shift_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("break")
}

model machine {
  id          Int     @id @default(autoincrement())
  type        String? @db.VarChar(100)
  description String?
}

model role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String?
  users       users[]
}

model shift {
  id               Int                      @id @default(autoincrement())
  name             String?                  @db.VarChar(10)
  start_time       DateTime?                @db.Time(6)
  end_time         DateTime?                @db.Time(6)
  duration         Unsupported("interval")? @default(dbgenerated("\nCASE\n    WHEN (end_time >= start_time) THEN (end_time - start_time)\n    ELSE ((end_time - start_time) + '24:00:00'::interval)\nEND"))
  st_flag          Boolean                  @default(false)
  et_flag          Boolean                  @default(false)
  actual_work_time String?                  @db.VarChar(50)
  renamedbreak     Renamedbreak[]
}

model users {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username   String    @db.VarChar(100)
  email      String?   @unique @db.VarChar(100)
  mobile_no  String?   @db.VarChar(15)
  password   String
  doj        DateTime? @db.Date
  process    String?   @db.VarChar(50)
  role_id    Int?
  role       role?     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
